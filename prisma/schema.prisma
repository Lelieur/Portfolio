generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContentDocument {
  id         String   @id @default(cuid())
  domain     String
  contentKey String
  draft      Json?
  published  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([domain, contentKey])
}
